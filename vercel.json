{
  "framework": "vite",
  "buildCommand": "node scripts/generate-seo-files.cjs && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://us-central1-z-build-dunvex.cloudfunctions.net/server/api/:path*" },
    { "source": "/product/:path*", "destination": "https://us-central1-z-build-dunvex.cloudfunctions.net/server/product/:path*" },
    { "source": "/products.json", "destination": "https://us-central1-z-build-dunvex.cloudfunctions.net/server/products.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
