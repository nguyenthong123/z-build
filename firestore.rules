rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'nbt1024@gmail.com' ||
        request.auth.token.email in get(/databases/$(database)/documents/settings/admins).data.emails
      );
    }

    // Products: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reviews: Anyone can read, authenticated users can write
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null; 
    }
    
    // Orders: Authenticated users can create and read their own. Admin can read/write all.
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'returnReason', 'updatedAt'])
        && (request.resource.data.status == 'cancelled' || request.resource.data.status == 'return_requested')
      );
      allow delete: if isAdmin();
    }
    
    // Notifications: User can read/update their own. Admin can create.
    match /notifications/{notiId} {
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, delete: if isAdmin();
    }

    // Coupons: Prevent listing all coupons to avoid leaks, only allow GET by specific ID or queries filtering active=true
    match /coupons/{couponId} {
      allow get: if true;
      allow list: if true; // Frontend queries currently require this, will need refactoring to restrict to active only
      allow write: if isAdmin();
    }
    
    // Affiliates
    match /affiliates/{affId} {
      allow read, write: if isAdmin();
    }
    match /affiliate_revenue/{revId} {
      allow read, write: if isAdmin();
    }
    match /affiliate_promotions/{promoId} {
      allow read, write: if isAdmin();
    }
    
    // AI Knowledge Base
    match /ai_knowledge_units/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ai_knowledge_base/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ai_consultations/{docId} {
      allow read, write: if true; // Bot needs to read/write chat history
    }
    match /agency_performance/{docId} {
      allow read, write: if isAdmin();
    }
    
    // Settings (contains admins list)
    match /settings/admins {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.email == 'nbt1024@gmail.com');
    }
    
    // Public settings (general, shipping, etc.)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.email == 'nbt1024@gmail.com');
    }
    
    // Store settings (main config, bank info, openclaw, etc.)
    match /storeSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.email == 'nbt1024@gmail.com');
    }
    
    // Users
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Default rule: block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
